# Build output
/bin/
/dist/
coverage.out

# Locally installed dev tools (make tools)
/hack/bin/

# Vendored dependencies are a local build aid for environments without
# module-proxy access; they are never committed.
/vendor/

# Assistant and editor tooling. Useful locally, not part of the product: the
# workflow these encode is documented in CONTRIBUTING.md and enforced by
# `make specs`, so nothing is lost by keeping them out of a clone.
/.claude/

# Editor / IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local scratch files
*.local.*

# npm is only ever used to run the openspec CLI here, and a stray `npm i`
# followed by `git add -A` would commit thousands of files nobody reviewed.
node_modules/
package.json
package-lock.json

# Owner tooling for this one GitHub account, not part of the product.
#
# `github-setup.sh` applies rulesets, secret scanning and CodeQL to
# github.com/remedik/remedik and reports the settings no API can change. It is
# useful to exactly one person and would read to everybody else as if the
# project expected them to run it. Kept on disk, out of the clone.
/hack/github-setup.sh
/.github/rulesets/

