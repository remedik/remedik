{
 "title": "remedik",
 "uid": "remedik-overview",
 "tags": [
  "remedik",
  "kubernetes",
  "remediation"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "description": "How remediation has behaved. Posture first \u2014 is remedik even allowed to act? \u2014 then outcomes, then what it was fed, then how long it took.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   },
   {
    "name": "strategy",
    "label": "Strategy",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(remedik_remediations_total, strategy)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Posture",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "stat",
   "title": "Mode",
   "description": "A flat remediation rate means one thing in dry-run and something else entirely when remedik is live. Read this panel before any of the others.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "max(remedik_dry_run)",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Live",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "Dry-run",
         "color": "purple",
         "index": 1
        }
       }
      }
     ],
     "noValue": "not scraped"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Build",
   "description": "The running version. A screenshot of this dashboard says which build produced it.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "expr": "remedik_build_info",
     "legendFormat": "{{version}}",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "name",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "not scraped"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Strategies enabled",
   "description": "Zero enabled is the difference between 'nothing has happened' and 'nothing can happen'.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "expr": "sum(remedik_strategies{enabled=\"true\"})",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "text",
        "value": 1
       }
      ]
     },
     "noValue": "0"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Pending or running",
   "description": "Remediations remedik itself is working through. Executions are serialised per object, so a number that stays high means the queue is not draining. Deliberately excludes what is waiting for a person -- that is the Awaiting approval panel, and a queue waiting on a human is not a busy operator.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "targets": [
    {
     "expr": "sum(remedik_remediation_records{state=~\"Pending|Running\"}) or vector(0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "row",
   "title": "Outcomes",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Remediations by outcome",
   "description": "The headline. Simulated means dry-run recorded a plan and changed nothing; a week of those is the report you show a team before turning dry-run off.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 9,
    "w": 16,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "expr": "sum by (outcome) (increase(remedik_remediations_total{strategy=~\"$strategy\"}[$__rate_interval]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 80,
      "barAlignment": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0,
      "gradientMode": "none"
     },
     "unit": "short",
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Succeeded"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Simulated"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "bargauge",
   "title": "Totals over the range",
   "description": "The same outcomes as a magnitude comparison, so the shape of the week is readable without counting bars.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 9,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "targets": [
    {
     "expr": "sum by (outcome) (increase(remedik_remediations_total{strategy=~\"$strategy\"}[$__range]))",
     "legendFormat": "{{outcome}}",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Succeeded"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Simulated"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "Remediation duration",
   "description": "From the first step starting to a terminal state. p95 climbing while p50 holds usually means one workload's rollout is slow, not that remedik is.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.50, sum by (le) (rate(remedik_remediation_duration_seconds_bucket{strategy=~\"$strategy\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(remedik_remediation_duration_seconds_bucket{strategy=~\"$strategy\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "s",
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "p50"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p95"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "Guard rejections",
   "description": "Executions the guards refused, by which guard refused them. This is the answer to 'why did nothing happen?' as a time series.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 15
   },
   "targets": [
    {
     "expr": "sum by (guard) (increase(remedik_guard_rejections_total{strategy=~\"$strategy\"}[$__rate_interval]))",
     "legendFormat": "{{guard}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 80,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0
     },
     "unit": "short",
     "min": 0,
     "noValue": "no guard refused anything in this range"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "cooldown"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "maxPerHour"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "row",
   "title": "Did anybody find out?",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 23
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Escalations by outcome",
   "description": "onFailure.steps running after a remediation failed for good. Failed means the page itself did not go out, which is the quietest failure remedik has: the remediation did not work and nobody was told.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "expr": "sum by (outcome) (increase(remedik_escalations_total{strategy=~\"$strategy\"}[$__rate_interval]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 80,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0
     },
     "unit": "short",
     "min": 0,
     "noValue": "nothing escalated in this range"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Succeeded"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "Failures nobody was told about",
   "description": "Failed remediations minus escalations that ran, so a non-zero value means a remediation failed and no channel was tried. Both sides are padded to zero independently: with one side missing its series, PromQL's vector matching yields nothing, and this panel would read as reassuring at exactly the moment escalation is not being recorded at all.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "targets": [
    {
     "expr": "clamp_min((sum(increase(remedik_remediations_total{outcome=\"Failed\",strategy=~\"$strategy\"}[$__rate_interval])) or vector(0)) - (sum(increase(remedik_escalations_total{strategy=~\"$strategy\"}[$__rate_interval])) or vector(0)), 0)",
     "legendFormat": "no escalation declared",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 80,
      "axisSoftMin": 0
     },
     "unit": "short",
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "no escalation declared"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "row",
   "title": "What remedik is being fed",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 32
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Alert flow",
   "description": "Alerts accepted, and how many matched no strategy. Unmatched is not an error \u2014 remedik answers 200 to anything it understood \u2014 but a line that is almost all unmatched means the strategies do not cover what this cluster fires.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 33
   },
   "targets": [
    {
     "expr": "sum(increase(remedik_alerts_received_total[$__rate_interval]))",
     "legendFormat": "Received",
     "refId": "A"
    },
    {
     "expr": "sum(increase(remedik_alerts_unmatched_total[$__rate_interval]))",
     "legendFormat": "Unmatched",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short",
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Received"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Unmatched"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "Deliveries remedik refused or lost",
   "description": "Three different problems, kept apart because their fixes are different: truncated means decisions were made on partial information, errors mean Alertmanager is retrying, unauthorised means something is knocking without a token.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 33
   },
   "targets": [
    {
     "expr": "sum(increase(remedik_alerts_truncated_total[$__rate_interval]))",
     "legendFormat": "Truncated",
     "refId": "A"
    },
    {
     "expr": "sum(increase(remedik_ingest_errors_total[$__rate_interval]))",
     "legendFormat": "Ingest errors",
     "refId": "B"
    },
    {
     "expr": "sum(increase(remedik_unauthorized_total[$__rate_interval]))",
     "legendFormat": "Unauthorised",
     "refId": "C"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "auto",
      "pointSize": 8,
      "spanNulls": true
     },
     "unit": "short",
     "min": 0,
     "noValue": "every delivery was accepted in this range"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Truncated"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Ingest errors"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Unauthorised"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "Records in the cluster",
   "description": "Remediation resources that exist right now, by state \u2014 what kubectl would show. Terminal records are pruned per strategy, so this plateaus rather than growing.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
