  {
   "type": "stat",
   "title": "Awaiting approval",
   "description": "Remediations a person has to decide on. Not a backlog: they are waiting on purpose. A number that grows means the strategies in approval mode are asking more often than anybody answers, and each one escalates when its timeout passes.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 49
   },
   "targets": [
    {
     "expr": "sum(remedik_remediation_records{state=\"AwaitingApproval\"}) or vector(0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "orange",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Records reclaimed by retention",
   "description": "Terminal records the retention sweep deleted. Flat at zero with a retention configured means nothing is old enough yet, or every candidate is still inside a guard window.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
